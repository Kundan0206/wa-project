{
  "name": "whatsapp-tech-provider",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm --filter @wa/web build",
    "build:all": "pnpm run --parallel build",
    "build:web": "pnpm --filter @wa/web build",
    "dev:web": "pnpm --filter @wa/web dev",
    "lint": "pnpm run --parallel lint",
    "db:generate": "pnpm --filter @wa/api run db:generate",
    "db:push": "pnpm --filter @wa/api run db:push",
    "db:migrate": "pnpm --filter @wa/api run db:migrate",
    "db:studio": "pnpm --filter @wa/api run db:studio"
  },
  "dependencies": {
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "20.x",
    "pnpm": "10.x"
  }
}
