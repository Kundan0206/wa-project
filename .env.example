# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET_NAME=whatsapp-media

# JWT (for fallback/API keys)
JWT_SECRET=change_this_to_a_secure_random_string

# Meta / WhatsApp API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=whatsapp_webhook_verify
META_REDIRECT_URI=https://yourdomain.com/api/v1/waba/callback
META_API_URL=https://graph.facebook.com/v19.0

# Razorpay (wallet top-ups, 1 INR = 1 credit)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Application URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Node
NODE_ENV=development
PORT=4000
